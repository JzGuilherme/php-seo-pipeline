# Application Environment
APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=stdout

# Database Configuration (MySQL 8.0+)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=seo_pipeline
DB_USERNAME=seo_user
DB_PASSWORD=your_db_password_here

# Google Gemini AI Configuration
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Queue Worker Configuration
WORKER_SLEEP_SECONDS=3
WORKER_MAX_MEMORY_MB=128
WORKER_MAX_ATTEMPTS=5

# E-commerce Platform Integrations (Optional Webhooks/REST)
WOOCOMMERCE_API_URL=https://example-store.com/wp-json/wc/v3
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here

MAGENTO_BASE_URL=https://example-magento.com/rest/V1
MAGENTO_ACCESS_TOKEN=your_magento_bearer_token_here
